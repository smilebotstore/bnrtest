# BNR Environment Configuration Example
PORT=3000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_super_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# Firebase Realtime Database
FIREBASE_PROJECT_ID=absensi-polri
FIREBASE_DATABASE_URL=https://your-project.firebasedatabase.app
FIREBASE_DB_PREFIX=bnr/

# Discord Webhook Notification Secrets
# 1. Webhook Transaksi (Transfer Saldo) - Plain Text format
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 2. Webhook Khusus Audit Log (Deteksi Login & Logout Pengguna/Admin) - Plain Text format
DISCORD_AUDIT_WEBHOOK_URL=https://discord.com/api/webhooks/your_audit_webhook_id/your_audit_webhook_token

# Initial Super Admin Seed Credentials
ADMIN_NAME=Haruukii Dharmawijaya
ADMIN_USERNAME=Haruukii79
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_ACCOUNT_NO=1200000001

# System Fees & Limits
PROFILE_CHANGE_FEE=5000000
TRANSFER_FEE=10000
TOPUP_FEE=5000
MIN_TRANSFER=10000
MAX_TRANSFER=100000000000000000
DAILY_TRANSFER_LIMIT=100000000000000000
